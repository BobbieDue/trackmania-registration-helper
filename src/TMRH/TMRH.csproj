<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 is built into Windows 10 (supported versions) and Windows 11: nothing to install -->
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <RootNamespace>Tmrh</RootNamespace>
    <AssemblyName>TrackMania-Registration-Helper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>TrackMania Registration Helper (TMRH)</Product>
    <Company>We Are Crazy TrackMania community</Company>
    <Description>Temporarily adjusts Internet Options so the old TrackMania Nations Forever / United Forever account registration works, then restores your original settings.</Description>
    <!-- reproducible builds: same source gives the same exe -->
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src</PathMap>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
